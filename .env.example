# Docker MySQL development settings. Copy to .env when custom values are needed.
MYSQL_DATABASE=cat_maintain
MYSQL_USER=catmaintain
MYSQL_PASSWORD=catmaintain
MYSQL_ROOT_PASSWORD=catmaintain_root
MYSQL_HOST_PORT=3307

# Spring Boot local/test settings. The defaults match the Compose service.
DB_URL=jdbc:mysql://localhost:3307/cat_maintain?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
DB_USERNAME=catmaintain
DB_PASSWORD=catmaintain
