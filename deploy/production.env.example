# Store as /home/ubuntu/cat-maintain/.env, chmod 600. Do not commit real credentials.
MYSQL_PASSWORD=replace-with-a-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-root-password
# BCrypt hash; single quotes preserve the dollar signs when this file is sourced.
# The deployment replaces only the default Admin123! hash, preserving later password changes.
ADMIN_PASSWORD_HASH='$2b$12$replace-with-a-real-bcrypt-hash'
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
